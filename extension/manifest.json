{
  "manifest_version": 3,
  "name": "AI Tutor Assistant Browser Sensor",
  "version": "1.0",
  "description": "Browser context sensor for AI Tutor Assistant",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
